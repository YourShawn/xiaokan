# Copy to .env and adjust. Used by docker compose and local Spring Boot.
# Never commit .env. Do not put a public IP or public DNS name for MySQL.

# --- MySQL ---
# Local processes (mvn / Vite): loopback only.
# Docker Compose talking to MySQL on the same host: host.docker.internal
# Bundled demo (`docker compose --profile bundled-mysql`): mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=xiaokan
MYSQL_USER=xiaokan
MYSQL_PASSWORD=xiaokan
MYSQL_ROOT_PASSWORD=change-me-root

# --- Backend ---
SERVER_PORT=8080
UPLOAD_DIR=./data/uploads

# OpenAI-compatible vision. If OPENAI_API_KEY is empty, mock mode is used
# (no network call; never pretends a real price tag was read).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# --- Frontend (Vite dev) ---
VITE_API_BASE=
